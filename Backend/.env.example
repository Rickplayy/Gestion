# Copia este archivo a .env y llena los valores reales.

NODE_ENV=development
HOST=0.0.0.0
PORT=3001

# MariaDB — misma BD SIGE_AG que ya usa sige-server
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=SIGE_AG
DB_CONNECTION_LIMIT=10

# Secreto para firmar los JWT. Genera uno largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRY=1h

# Origen permitido para CORS (URL del frontend)
FRONTEND_ORIGIN=http://localhost:5173

# Ruteo (distancia real por calles hacia UPIICSA)
OSRM_URL=http://localhost:5000
UPIICSA_LAT=
UPIICSA_LON=

# Credenciales del admin inicial (se siembra solo si SIGE_ADMIN está vacía)
ADMIN_USER=admin
ADMIN_PASS=
