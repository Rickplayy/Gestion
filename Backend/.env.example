# Copia este archivo a .env y llena los valores reales.
# El servidor NO arranca sin JWT_SECRET.

PORT=3001

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=tu_password_de_postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestion_db

# Secreto para firmar los JWT. Genera uno largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Credenciales del admin inicial (se siembra solo si la tabla está vacía)
ADMIN_USER=admin
ADMIN_PASS=

# Origen permitido para CORS (URL del frontend)
FRONTEND_ORIGIN=http://localhost:5173
