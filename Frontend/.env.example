# Copia este archivo a .env para configurar el cálculo de distancias.
# Todo es opcional: sin .env el sistema usa los valores por defecto de abajo.

# Servidor OSRM para distancia real por calles. Es software que se hospeda uno
# mismo (https://project-osrm.org), no un servicio de paga.
#
# Sin definir esta variable se usa el servidor público de demostración
# (https://router.project-osrm.org), que ya da distancia real por calles. Ese
# servidor es de cortesía y su política prohíbe uso intensivo: para corridas
# grandes o producción, levanta OSRM propio y ponlo aquí.
#
# Déjala VACÍA (VITE_OSRM_URL=) para apagar el ruteo y estimar en línea recta.
# VITE_OSRM_URL=http://localhost:5000

# Geocodificador (domicilio -> coordenadas). Por defecto usa el Nominatim
# público, que permite 1 petición por segundo. Para generar cohortes grandes
# conviene levantar una instancia propia y apuntarla aquí.
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org

# Espera entre peticiones al geocodificador, en milisegundos.
# Con instancia propia se puede bajar a 0 y todo va mucho más rápido.
VITE_GEOCODER_INTERVAL_MS=1100

# Punto de referencia al que se mide la distancia (la escuela).
# Por defecto UPIICSA.
VITE_REF_LAT=19.396056
VITE_REF_LON=-99.091901
